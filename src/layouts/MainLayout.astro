---
import "../styles/global.css";

const {
  title = "StayJustIn | West Covina News",
  description = "West Covina news, City Hall updates, development projects, and local issues explained simply.",
  canonical = "https://www.stayjustin.com/"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph (for social sharing) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <!-- HEADER -->
    <header class="topbar">
      <div class="container nav">
        <a href="/" class="brand-link">
          <div class="brand-title">StayJustIn</div>
        </a>

        <div class="nav-links">
          <a href="/city-hall/">City Hall</a>
          <a href="/west-covina-news/">News</a>
          <a href="/development/">Development</a>
        </div>

        <a
          href="https://stayjustin.substack.com/"
          class="btn btn-primary nav-subscribe"
          target="_blank"
        >
          Subscribe
        </a>
      </div>
    </header>

    <!-- MAIN CONTENT -->
    <main>
      <slot />
    </main>

    <!-- SCRIPTURE (SUBTLE BRAND ELEMENT) -->
    <div class="container" style="text-align:center; margin-top:40px;">
      <p style="color:#6b7280; font-size:0.9rem;">
        “Speak up for those who cannot speak for themselves.”
      </p>
    </div>

    <!-- FOOTER -->
    <footer class="footer">
      <div class="container footer-inner">
        <div>
          <div class="footer-title">StayJustIn</div>
          <p>
            West Covina news, City Hall updates, development, events, and local
            issues explained simply.
          </p>
        </div>

        <div>
          <div class="footer-title">Explore</div>
          <div class="footer-links">
            <a href="/city-hall/">City Hall</a>
            <a href="/west-covina-news/">News</a>
            <a href="/development/">Development</a>
            <a href="/events/">Events</a>
          </div>
        </div>

        <div>
          <div class="footer-title">More</div>
          <div class="footer-links">
            <a href="/about/">About</a>
            <a href="/contact/">Contact</a>
          </div>
        </div>

        <div>
          <div class="footer-title">Connect</div>
          <p>West Covina, CA</p>
          <p>hello@stayjustin.com</p>
        </div>
      </div>

      <div class="footer-bottom">
        © {new Date().getFullYear()} StayJustIn. All rights reserved.
      </div>
    </footer>
  </body>
</html>
