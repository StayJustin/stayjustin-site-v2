---
import "../styles/global.css";

const title = Astro.props.title ?? "StayJustIn";
const description = Astro.props.description ?? "West Covina news, City Hall updates, development, and local issues.";
const canonical = Astro.props.canonical ?? "https://www.stayjustin.com/";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
  </head>

  <body>
