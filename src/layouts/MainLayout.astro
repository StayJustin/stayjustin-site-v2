---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const {
  title = "StayJustin | West Covina News",
  description = "West Covina news, city hall updates, new businesses, development, traffic, and local events explained simply.",
  canonical = "https://www.stayjustin.com/"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta name="google-site-verification" content="googlef61280c40168ecf4.html" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>

  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
