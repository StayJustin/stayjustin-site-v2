---
import MainLayout from "../../layouts/MainLayout.astro";
import ArticleSummary from "../../components/ArticleSummary.astro";

const title = "Milan Mrakich Appointed Permanent City Manager | StayJustIn";
const description = "A developing breakdown of West Covina's appointment of Milan Mrakich as permanent City Manager, including contract terms, qualifications, salary, and future priorities.";
---

<MainLayout
  title={title}
  description={description}
  canonical="https://www.stayjustin.com/city-hall/west-covina-city-manager-milan-mrakich/"
>
  <section class="article-page">
    <div class="container article-container">
      <p class="page-kicker">City Hall Watch</p>

      <h1>Milan Mrakich Appointed Permanent City Manager</h1>

      <ArticleSummary text="West Covina appointed Milan Mrakich as permanent City Manager, raising resident questions about contract terms, qualifications, performance goals, and future city priorities." />

      <p><strong>Status:</strong> Developing Story</p>

      <div class="info-box">
        <h2>What We Know So Far</h2>

        <ul class="check-list">
          <li>West Covina appointed Milan Mrakich as permanent City Manager.</li>
          <li>He previously served as Acting City Manager.</li>
          <li>He has decades of public sector experience.</li>
          <li>Residents are asking about salary, qualifications, contract terms, and future priorities.</li>
        </ul>
      </div>

      <div class="info-box">
        <h2>Questions Residents Are Asking</h2>

        <ul class="question-list">
          <li>What are the contract terms?</li>
          <li>What goals has the Council set?</li>
          <li>How will performance be evaluated?</li>
          <li>What priorities should residents watch?</li>
        </ul>
      </div>

      <p>
        StayJustIn is reviewing public documents, council discussions, and future city actions to update this story.
      </p>

      <hr />

      <p><em>Full investigation coming soon.</em></p>
    </div>
  </section>
</MainLayout>
