---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Contact StayJustin | West Covina News & Updates"
  description="Contact StayJustin for tips, local news submissions, corrections, or questions about West Covina coverage."
  canonical="https://www.stayjustin.com/contact/"
>
  <section class="section">
    <div class="container intro-block">
      <h1 class="section-title">Contact</h1>

      <p class="intro-copy">
        Have a tip, correction, or something happening in West Covina people should know about?
        Send it over.
      </p>

      <p class="intro-copy">
        StayJustin focuses on clear, simple breakdowns of City Hall decisions, local issues,
        development, and events — and community input helps keep that accurate.
      </p>

      <h2 class="section-title" style="margin-top: 30px;">Ways to Reach Out</h2>

      <p class="intro-copy">
        📩 Email: 
        <a href="mailto:Justin@StayJustIn.com">Justin@StayJustIn.com</a>
      </p>

      <p class="intro-copy">
        📰 Substack:
        <a href="https://stayjustin.substack.com/" target="_blank" rel="noopener noreferrer">
          Subscribe and message here
        </a>
      </p>

      <p class="intro-copy">
        🌐 Website:
        <a href="/">Back to homepage</a>
      </p>

      <h2 class="section-title" style="margin-top: 30px;">What You Can Send</h2>

      <ul style="margin-top: 10px; color: var(--muted); line-height: 1.7;">
        <li>Local news tips</li>
        <li>City Hall concerns</li>
        <li>Corrections or clarifications</li>
        <li>Upcoming events</li>
        <li>Business openings</li>
      </ul>

      <p class="intro-copy" style="margin-top: 20px;">
        Not everything can be covered immediately, but all submissions are reviewed.
      </p>
    </div>
  </section>
</MainLayout>
