---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  title="Contact StayJustin"
  description="Contact StayJustin with tips, questions, local story ideas, or corrections."
  canonical="https://www.stayjustin.com/contact/"
>
  <div style="max-width: 800px; margin: 40px auto; padding: 24px; background: white; color: black; border: 1px solid #ddd; border-radius: 12px;">
    <h1 style="font-size: 2rem; margin-bottom: 16px;">Contact</h1>

    <p style="margin-bottom: 16px;">
      Have a tip, correction, story idea, or local update to share? Reach out here.
    </p>

    <p style="margin-bottom: 16px;">
      Email: <a href="mailto:Justin@StayJustin.com">Justin@StayJustin.com</a>
    </p>

    <p style="margin-bottom: 16px;">
      For the fastest updates, you can also follow the newsletter and linked coverage across the site.
    </p>

    <p style="margin-bottom: 16px;">
      <a href="/">Back to homepage</a>
    </p>
  </div>
</MainLayout>
