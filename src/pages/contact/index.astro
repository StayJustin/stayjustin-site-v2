---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  title="Contact | StayJustin"
  description="Contact StayJustin for tips, corrections, or questions."
  canonical="https://www.stayjustin.com/contact/"
>
  <main style="max-width: 800px; margin: 0 auto; padding: 40px 20px;">
    <h1 style="font-size: 2rem; margin-bottom: 16px;">Contact</h1>

    <p style="margin-bottom: 16px;">
      Have a tip, correction, or something happening in West Covina people should know about?
      Reach out here.
    </p>

    <p style="margin-bottom: 16px;">
      StayJustin covers West Covina news, City Hall updates, investigations, development, and local events.
      If you have information that helps residents stay informed, feel free to send it over.
    </p>

    <p style="margin-bottom: 16px;">
      Email:
      <a href="mailto:Justin@StayJustIn.com">Justin@StayJustIn.com</a>
    </p>

    <p style="margin-bottom: 16px;">
      Substack:
      <a href="https://stayjustin.substack.com/" target="_blank" rel="noopener noreferrer">
        stayjustin.substack.com
      </a>
    </p>

    <p style="margin-bottom: 16px;">
      <a href="/tech-help/">Need help with Wi-Fi, printers, device setup, or privacy cleanup? Visit the Tech Help page.</a>
    </p>

    <p style="margin-bottom: 16px;">
      <a href="/">Back to homepage</a>
    </p>
  </main>
</MainLayout>
