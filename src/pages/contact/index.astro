---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  title="Contact StayJustin | West Covina News Tips & Questions"
  description="Contact StayJustin with West Covina news tips, corrections, story ideas, or questions about local coverage."
  canonical="https://www.stayjustin.com/contact/"
>
  <section class="section">
    <div class="container">
      <div class="content-box">

        <h1>Contact StayJustin</h1>

        <p class="lead">
          Have a tip, correction, or something happening in West Covina people should know about?
          Reach out directly.
        </p>

        <p>
          StayJustin covers West Covina news, City Hall updates, investigations,
          development, and local events — explained clearly for residents.
        </p>

        <p>
          📩 <strong>Email:</strong><br />
          <a href="mailto:Justin@StayJustin.com">Justin@StayJustin.com</a>
        </p>

        <p>
  Prefer to stay anonymous? You can still send tips — just include whatever details you're comfortable sharing.
</p>
        <p>
          📰 <strong>Newsletter:</strong><br />
          <a href="https://stayjustin.substack.com/" target="_blank">
            stayjustin.substack.com
          </a>
        </p>

        <p>
          💻 Need help with Wi-Fi, printers, device setup, or privacy cleanup?<br />
          <a href="/tech-help/">Visit the Tech Help page</a>
        </p>

        <p>
          ← <a href="/">Back to homepage</a>
        </p>

      </div>
    </div>
  </section>
</MainLayout>
