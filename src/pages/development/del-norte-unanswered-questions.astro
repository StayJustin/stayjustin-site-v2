---
import MainLayout from "../../layouts/MainLayout.astro";
import ArticleSummary from "../../components/ArticleSummary.astro";

const title =
  "The Del Norte Questions Residents Are Still Waiting On | StayJustIn";

const description =
  "The Del Norte project has been approved, but many questions remain about traffic, parks, maintenance costs, affordability, and long-term impacts.";
---

<MainLayout
  title={title}
  description={description}
  canonical="https://www.stayjustin.com/development/del-norte-unanswered-questions/"
>
  <section class="article-page">
    <div class="container article-container">
      <p class="page-kicker">Accountability Watch</p>

      <h1>The Del Norte Questions Residents Are Still Waiting On</h1>

      <ArticleSummary text="The Del Norte project has been approved, but several important questions remain unanswered and will likely continue to be discussed as the project moves forward." />

      <p><strong>Status:</strong> Ongoing Accountability Tracker</p>

      <div class="info-box">
        <h2>What We Know So Far</h2>

        <ul class="check-list">
          <li>The project was approved by a 3-2 vote</li>
          <li>232 housing units were approved</li>
          <li>1.45 acres of park land will be dedicated</li>
          <li>$961,350 in park fees will be paid</li>
        </ul>
      </div>

      <div class="info-box">
        <h2>Questions Residents Continue Asking</h2>

        <ul class="question-list">
          <li>Where will the park fee ultimately be spent?</li>
          <li>Will the baseball field serve the same age groups?</li>
          <li>Has Del Norte been studied together with City Yard?</li>
          <li>What long-term maintenance costs will the City inherit?</li>
          <li>How will traffic change once the project is occupied?</li>
          <li>Will the homes be affordable for typical West Covina families?</li>
        </ul>
      </div>

      <p>
        StayJustIn will continue tracking these questions through future council
        meetings, budget discussions, project approvals, and public documents.
      </p>

      <hr />

      <p><em>This page will be updated as new information becomes available.</em></p>
    </div>
  </section>
</MainLayout>
