---
import MainLayout from "../../layouts/MainLayout.astro";
import ArticleSummary from "../../components/ArticleSummary.astro";

const title = "The Del Norte Baseball Field Debate Explained | StayJustIn";
const description =
  "The baseball field became one of the most debated parts of the Del Norte project. Here's what residents are asking and what remains unresolved.";
---

<MainLayout
  title={title}
  description={description}
  canonical="https://www.stayjustin.com/development/del-norte-field-debate/"
>
  <section class="article-page">
    <div class="container article-container">
      <p class="page-kicker">Parks & Recreation</p>

      <h1>The Del Norte Baseball Field Debate Explained</h1>

      <ArticleSummary text="The baseball field became one of the most discussed parts of the Del Norte project and remains one of the biggest unresolved questions for many residents." />

      <p><strong>Status:</strong> Developing Story</p>

      <div class="info-box">
        <h2>What We Know So Far</h2>

        <ul class="check-list">
          <li>1.45 acres will be dedicated to the City</li>
          <li>Up to $250,000 in field improvements are required</li>
          <li>The field will become part of Del Norte Park</li>
          <li>Little League supporters raised concerns during public meetings</li>
        </ul>
      </div>

      <div class="info-box">
        <h2>Questions Residents Are Asking</h2>

        <ul class="question-list">
          <li>Is this a true replacement field?</li>
          <li>Will older age divisions still be able to play?</li>
          <li>Will recreational capacity be reduced?</li>
          <li>What will the final field dimensions be?</li>
        </ul>
      </div>

      <p>
        StayJustIn is reviewing project plans, council discussions, and public
        comments to better understand how the approved field compares to what
        previously existed.
      </p>

      <hr />

      <p><em>Full investigation coming soon.</em></p>
    </div>
  </section>
</MainLayout>
