---
import MainLayout from "../../layouts/MainLayout.astro";

const title = "City Yard / Brandywine Redevelopment Explained | StayJustIn";
const description = "A developing breakdown of West Covina's City Yard and Brandywine redevelopment proposal, including public land, relocation costs, Fire Station 1, and long-term city impacts.";
---

<MainLayout
  title={title}
  description={description}
  canonical="https://www.stayjustin.com/development/west-covina-city-yard-brandywine/"
>
  <section class="article-page">
    <div class="container article-container">
      <p class="page-kicker">Development Watch</p>

      <h1>City Yard / Brandywine Redevelopment Explained</h1>

      <p class="article-dek">
        West Covina residents are asking what the proposed City Yard redevelopment could mean for public land, city operations, Fire Station 1, and future development impacts.
      </p>

      <p><strong>Status:</strong> Developing Story</p>

      <div class="info-box">
        <h2>What We Know So Far</h2>

        <ul class="check-list">
          <li>The proposal involves City-owned property.</li>
          <li>The City entered discussions involving Brandywine and potential redevelopment of the City Yard site.</li>
          <li>Residents are asking about public land, relocation costs, and long-term city impacts.</li>
        </ul>
      </div>

      <div class="info-box">
        <h2>Questions Residents Are Asking</h2>

        <ul class="question-list">
          <li>What happens to City Yard operations?</li>
          <li>What happens to Fire Station 1?</li>
          <li>What are the long-term costs?</li>
          <li>How does this connect to Del Norte?</li>
        </ul>
      </div>

      <p>
        StayJustIn is reviewing public documents, council discussions, and future city actions to update this story.
      </p>

      <hr />

      <p><em>Full investigation coming soon.</em></p>
    </div>
  </section>
</MainLayout>
