---

import MainLayout from "../../layouts/MainLayout.astro";
import ArticleStyles from "../../components/ArticleStyles.astro";

const title =
"373 Homes, 1.2 Miles Apart: Has West Covina Studied the Combined Impact? | StayJustIn";

const description =
"Residents have asked whether Del Norte and the City Yard proposal have been evaluated together for traffic, parks, public safety, and infrastructure impacts.";

<MainLayout
title={title}
description={description}
canonical="https://www.stayjustin.com/development/del-norte-city-yard-combined-impact/"

«»

  <ArticleStyles />  <section class="article-page">
    <div class="container article-container">  <p class="page-kicker">Development Watch</p>

  <h1>373 Homes, 1.2 Miles Apart: Has West Covina Studied the Combined Impact?</h1>

  <p class="article-dek">
    Residents have repeatedly asked whether the Del Norte project and the proposed City Yard redevelopment have been evaluated together.
  </p>

  <p><strong>Status:</strong> Developing Story</p>

  <div class="info-box">
    <h2>What We Know So Far</h2>

    <ul class="check-list">
      <li>Del Norte proposes 232 homes</li>
      <li>City Yard proposes approximately 141 homes</li>
      <li>Combined total: 373 homes</li>
      <li>The projects are roughly 1.2 miles apart</li>
    </ul>
  </div>

  <div class="info-box">
    <h2>Questions Residents Are Asking</h2>

    <ul class="question-list">
      <li>Have both projects been studied together?</li>
      <li>What are the combined traffic impacts?</li>
      <li>How could parks and public safety be affected?</li>
      <li>What infrastructure upgrades may be needed?</li>
    </ul>
  </div>

  <p>
    StayJustIn is reviewing project documents, environmental reports,
    and future council discussions to better understand the cumulative
    impact of both developments.
  </p>

  <hr />

  <p><em>Full investigation coming soon.</em></p>

</div>

  </section></MainLayout>
