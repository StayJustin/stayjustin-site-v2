---
import MainLayout from "../../layouts/MainLayout.astro";
import PrincipleVerse from "../../components/PrincipleVerse.astro";

const title = "West Covina Development Projects | StayJustIn";
const description =
  "Track West Covina development projects including the City Yard (Brandywine), Del Norte housing proposal, and other major planning decisions explained in plain English.";
---

<MainLayout
  title={title}
  description={description}
  canonical="https://www.stayjustin.com/development/"
>

  <!-- HERO / INTRO -->
  <section class="section">
    <div class="container">
      <article class="content hub-page">
        <p class="page-kicker">West Covina Development</p>
        <h1>Development Projects Residents Should Watch</h1>

        <div class="summary-box">
          <p>
            Major housing and land-use decisions are shaping West Covina’s future —
            from the City Yard sale to new residential developments.
          </p>
        </div>

        <p>
          This page tracks the most important development projects so residents can
          understand what’s being proposed, what it could cost, and how it may impact
          traffic, safety, infrastructure, and the city budget.
        </p>
      </article>
    </div>
  </section>

  <!-- 🔥 FEATURED PROJECT -->
  <section class="featured-section">
    <div class="container">
      <div class="featured-card">
        <span class="featured-badge">Featured Project</span>

        <h2>
          <a href="/development/west-covina-city-yard-brandywine-project/">
            City Yard (Brandywine) Development Proposal Explained
          </a>
        </h2>

        <p>
          West Covina is considering selling City-owned land while relocating Fire Station 1
          and City operations. This breakdown explains the deal, the risks, and the key questions residents should ask.
        </p>

        <a href="/development/west-covina-city-yard-brandywine-project/" class="read-more">
          Read full breakdown →
        </a>
      </div>
    </div>
  </section>

  <!-- 🧩 PROJECT BREAKDOWNS -->
  <section class="section">
    <div class="container">
      <div class="section-header clean-header">
        <div>
          <h2 class="section-title">Project Breakdowns</h2>
          <p class="section-sub">Individual developments explained in plain English.</p>
        </div>
      </div>

      <div class="story-grid">

        <!-- Del Norte -->
        <article class="story-card">
          <span class="story-tag">Housing</span>
          <h3>
            <a href="/development/del-norte-housing-project-west-covina/">
              Del Norte Housing Project: What Residents Should Know
            </a>
          </h3>
          <p>
            A proposed residential development on a former school site raises questions about traffic,
            parking, safety, and long-term City costs.
          </p>
        </article>

        <!-- City Yard -->
        <article class="story-card">
          <span class="story-tag">City Property</span>
          <h3>
            <a href="/development/west-covina-city-yard-brandywine-project/">
              City Yard Sale & Brandywine Proposal Breakdown
            </a>
          </h3>
          <p>
            The City may sell a major property and relocate core services. Here’s what that means and what’s still unclear.
          </p>
        </article>

      </div>
    </div>
  </section>

  <!-- 🔗 CONNECTED ISSUES -->
  <section class="section topics-section">
    <div class="container">
      <h2 class="section-title">How Development Connects to Other Issues</h2>

      <div class="topics-grid">
        <a href="/city-hall/" class="topic-card">
          <span>🏛️</span> City Hall Decisions
        </a>

        <a href="/west-covina-news/" class="topic-card">
          <span>📰</span> Local News
        </a>

        <a href="/events/" class="topic-card">
          <span>📍</span> Community Impact
        </a>
      </div>
    </div>
  </section>

  <!-- 🔻 BOTTOM LINKS (NO CARDS) -->
  <section class="section bottom-links-section">
    <div class="container">
      <div class="bottom-links-card">
        <h2>More Local Coverage</h2>
        <p>Explore other areas impacting West Covina residents.</p>

        <div class="bottom-link-list">
          <a href="/tech-help/">Tech</a>
          <a href="/city-hall/">City Hall</a>
          <a href="/west-covina-news/">News</a>
          <a href="/new-businesses/">Business</a>
          <a href="/events/">Events</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ✝️ “Suppose one of you wants to build a tower. Won’t you first sit down and estimate the cost?” — Luke 14:28 -->
  <PrincipleVerse />

</MainLayout>
