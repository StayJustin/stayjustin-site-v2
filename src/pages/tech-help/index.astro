---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  title="West Covina Tech Help | Wi-Fi, Printers, Home Setup & Privacy Cleanup"
  description="Local tech help in West Covina for Wi-Fi issues, printer setup, device connections, speed improvements, and privacy cleanup."
  canonical="https://www.stayjustin.com/tech-help/"
>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Local Tech Help</span>
      <h1>Simple Tech Help for West Covina</h1>
      <p>
        Honest local help for Wi-Fi problems, printer issues, device setup,
        speed improvements, and privacy cleanup.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container intro-block">
      <h2 class="section-title">What I Help With</h2>
      <p class="section-sub">
        Practical help for everyday tech problems at home.
      </p>
      <p class="intro-copy">
        If your Wi-Fi keeps dropping, your printer refuses to cooperate, your devices are not connecting,
        or your home setup just feels frustrating, this page is for you.
      </p>
      <p class="intro-copy">
        The goal is simple: solve common tech problems clearly, without jargon, upsells, or unnecessary confusion.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container intro-block">
      <h2 class="section-title">Services & Pricing</h2>

      <p class="intro-copy">
        <strong>🔧 Basic Fix — $40</strong><br />
        One issue solved, like Wi-Fi trouble, printer setup, device connection issues, or basic troubleshooting.
      </p>

      <p class="intro-copy">
        <strong>🏠 Home Setup — $75–$100</strong><br />
        Wi-Fi optimization, device connections, setup help, and practical speed improvements for your home.
      </p>

      <p class="intro-copy">
        <strong>🔒 Privacy Cleanup — $60</strong><br />
        Help removing personal information online, plus basic phone and browser privacy setup.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container intro-block">
      <h2 class="section-title">Who This Is For</h2>
      <p class="intro-copy">
        This is for people who want reliable, understandable help without being talked down to.
        Whether you are dealing with slow internet, setup frustration, or privacy concerns,
        the goal is to get things working and make your setup easier to manage.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container intro-block">
      <h2 class="section-title">Book Tech Help</h2>
      <p class="intro-copy">
        To ask a question or book help, email:
        <a href="mailto:Justin@StayJustin.com?subject=Tech%20Help%20Request">Justin@StayJustin.com</a>
      </p>
      <p class="intro-copy">
        Include a short description of the issue, what device or service is involved,
        and whether you need help in person or just want to start with questions.
      </p>
    </div>
  </section>
</MainLayout>
