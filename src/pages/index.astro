---
import MainLayout from "../layouts/MainLayout.astro";
import HubIconGrid from "../components/HubIconGrid.astro";
---

<MainLayout
  title="West Covina News, City Hall Updates & Local Events | StayJustin"
  description="StayJustin covers West Covina news, city hall updates, new businesses, development, traffic changes, and local events in simple terms."
  canonical="https://www.stayjustin.com/"
>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">West Covina in simple terms</span>
      <h1>What’s Going On in West Covina</h1>
      <p>
        Clear updates on City Hall, new businesses, development,
        traffic changes, and local events — explained the way a neighbor would.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container intro-block">
      <h2 class="section-title">What’s Happening in West Covina Right Now</h2>
      <p class="section-sub">
        StayJustin covers West Covina news, City Hall decisions, new businesses,
        development projects, traffic updates, and local events in one place.
      </p>
      <p class="intro-copy">
        This site is built for busy residents who want to understand what is happening in West Covina
        without digging through long agendas, scattered posts, or city jargon. From planning commission
        meetings to restaurant openings and road changes, the focus is on the updates that actually affect
        everyday life.
      </p>
      <p class="intro-copy">
        Use the sections below to explore the main topics shaping West Covina right now, including
        <a href="/city-hall/">City Hall updates</a>,
        <a href="/new-businesses/">new businesses</a>,
        <a href="/development/">development projects</a>,
        <a href="/traffic-road-closures/">traffic and road closures</a>,
        and <a href="/events/">local events</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container intro-block">
      <h2 class="section-title">Featured City Hall Coverage</h2>
      <p class="section-sub">
        Follow the main West Covina City Hall story as it develops.
      </p>
      <p class="intro-copy">
        The biggest City Hall story right now involves investigations, a formal censure vote,
        questions about public spending, and broader conflict inside city leadership.
        Start here for the clearest breakdown:
      </p>
      <p class="intro-copy">
        <a href="/city-hall/west-covina-city-hall-investigation/">
          What’s Happening at West Covina City Hall? Full Investigation Breakdown
        </a>
      </p>
      <p class="intro-copy">
        You can also follow the supporting coverage here:
      </p>
      <p class="intro-copy">
        <a href="/city-hall/west-covina-city-hall-timeline/">West Covina City Hall timeline</a><br />
        <a href="/city-hall/west-covina-gutierrez-censure/">Why Brian Gutierrez was censured</a>
      </p>
    </div>
  </section>

  <HubIconGrid />
</MainLayout>
