---
import MainLayout from "../layouts/MainLayout.astro";
import IssueCard from "../components/IssueCard.astro";
import WhatToWatch from "../components/WhatToWatch.astro";
import { featuredIssue, issues } from "../data/issues";
---

<MainLayout
  title="StayJustIn | West Covina News, Development & City Hall Updates"
  description="StayJustIn explains West Covina development, City Hall decisions, public spending, parks, traffic, street sweeping, pets, and neighborhood issues in plain English."
  canonical="https://www.stayjustin.com/"
>
  <section class="news-hero">
    <div class="container">
      <span class="eyebrow">West Covina in simple terms</span>
      <h1>What’s Happening in West Covina Right Now</h1>
      <p>
        Clear updates on development, City Hall, budgets, parks, public safety,
        traffic, pets, and neighborhood issues — without the noise.
      </p>
    </div>
  </section>

  <section class="section budget-front-feature" aria-labelledby="budget-front-title">
    <div class="container">
      <article class="budget-front-card">
        <div class="budget-front-copy">
          <p class="budget-front-date">UPDATED NOVEMBER 11, 2026 · BUDGET & ACCOUNTABILITY</p>
          <h2 id="budget-front-title"><a href="/accountability/budget-spending/#adopted-budget-heading">West Covina's $148.4 Million Budget: What Residents Should Know</a></h2>
          <p>The City Council adopted its FY 2026–27 budget in June. Our new review explains where the money is budgeted, why the General Fund's projected annual gain is just $107,896, and what staffing, insurance, and capital-project questions remain.</p>
          <a class="budget-front-link" href="/accountability/budget-spending/#adopted-budget-heading">Read the budget breakdown and see the chart →</a>
        </div>
        <div class="budget-front-figures" aria-label="Budgeted citywide revenue 162.04 million dollars; expenditures 148.43 million dollars; projected General Fund annual gain 107,896 dollars">
          <div><span>Expected revenue</span><strong>$162.04M</strong></div>
          <div><span>Planned spending</span><strong>$148.43M</strong></div>
          <div><span>General Fund annual gain</span><strong>$107,896</strong></div>
          <small>Adopted projections, not actual year-end results. Source: Resolution 2026-44.</small>
        </div>
      </article>
    </div>
  </section>

  <WhatToWatch />

  <section class="section latest-coverage" aria-label="Latest resident updates">
    <div class="container">
      <div class="section-header clean-header">
        <div>
          <p class="page-kicker budget-coverage-date">UPDATED NOVEMBER 11, 2026</p>
          <h2 class="section-title">Latest Updates Residents Should Know</h2>
          <p class="section-sub">Time-sensitive public notices and follow-up reporting, separate from our featured city budget analysis.</p>
        </div>
      </div>
      <div class="story-grid">
        <article class="story-card">
          <span class="story-tag">Pets · Starts November 12</span>
          <h3><a href="/community-pets/west-covina-spay-neuter-microchip-requirements/">County announces animal licensing enforcement in West Covina</a></h3>
          <p>County officers plan to begin licensing checks in ZIP codes 91791 and 91792. Unlicensed pets may incur a $40 field enforcement fee in addition to other applicable charges. Check requirements and assistance options.</p>
          <a class="read-more-link" href="/community-pets/west-covina-spay-neuter-microchip-requirements/">What pet owners need to know →</a>
        </article>
        <article class="story-card">
          <span class="story-tag">Fire Station 3 · August agenda</span>
          <h3><a href="/accountability/fire-station-3/">City proposed closing Fire Station 3 emergency repair action</a></h3>
          <p>An August 18 agenda item recommended ending the rodent-remediation emergency and accepting contractor work for $130,720.85. The final vote and filed completion notice still need verification.</p>
          <a class="read-more-link" href="/accountability/fire-station-3/">Read the documented proposal →</a>
        </article>
        <article class="story-card">
          <span class="story-tag">Street Sweeping · Enforcement Suspended</span>
          <h3><a href="/accountability/street-sweeping/">No street-sweeping warnings or citations during route review</a></h3>
          <p>The city's current notice says sweeping continues, but parking warnings and citations remain suspended while schedules are reevaluated. A restart date has not been announced.</p>
          <a class="read-more-link" href="/accountability/street-sweeping/">Read the current status →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="featured-section">
    <div class="container">
      <div class="section-header clean-header">
        <div>
          <h2 class="section-title">Featured Issue</h2>
          <p class="section-sub">
            The issue residents are asking about right now.
          </p>
        </div>
        <a class="view-all" href="/accountability/">View Accountability</a>
      </div>

      <IssueCard
        title={featuredIssue.title}
        emoji={featuredIssue.emoji}
        status={featuredIssue.status}
        statusLabel={featuredIssue.statusLabel}
        summary={featuredIssue.summary}
        href={featuredIssue.href}
        lastUpdated={featuredIssue.lastUpdated}
        featured
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header clean-header">
        <div>
          <h2 class="section-title">Active Issues</h2>
          <p class="section-sub">
            Living topics StayJustIn is tracking beyond a single article.
          </p>
        </div>
      </div>

      <div class="story-grid">
        {issues.map((issue) => (
          <IssueCard
            title={issue.title}
            emoji={issue.emoji}
            status={issue.status}
            statusLabel={issue.statusLabel}
            summary={issue.summary}
            href={issue.href}
            lastUpdated={issue.lastUpdated}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header clean-header">
        <div>
          <h2 class="section-title">Del Norte Project Coverage</h2>
          <p class="section-sub">
            The main questions residents are asking after the 3-2 approval vote.
          </p>
        </div>
        <a class="view-all" href="/development/">View Development</a>
      </div>

      <div class="story-grid">
        <article class="story-card">
          <span class="story-tag">Park Fees</span>
          <h3>
            <a href="/development/del-norte-park-fee/">
              Where does the Del Norte park fee go?
            </a>
          </h3>
          <p>
            The Del Norte project will generate $961,350 
            in park fees, but residents still don't know 
            where the money will ultimately be spent. 
            Future discussions could determine whether 
            funds support Del Norte Park, Little League 
            improvements, or other city park projects.
          </p>
        </article>

        <article class="story-card">
          <span class="story-tag">Little League</span>
          <h3>
            <a href="/development/del-norte-field-debate/">
              The Del Norte baseball field debate explained
            </a>
          </h3>
          <p>
            The baseball field became one of the most debated parts of the project. Supporters say the City gains new park land and improvements, while Little League advocates question whether the replacement field will serve the same age groups as before.
          </p>
        </article>

        <article class="story-card">
          <span class="story-tag">Combined Impact</span>
          <h3>
            <a href="/development/del-norte-city-yard-combined-impact/">
              373 homes, 1.2 miles apart: has West Covina studied the combined impact?
            </a>
          </h3>
          <p>
            Together, the Del Norte and City Yard proposals could add 373 housing units within roughly 1.2 miles of each other. Residents have asked whether the City has studied the combined impact on traffic, public safety, parks, and infrastructure.
          </p>
        </article>

        <article class="story-card">
          <span class="story-tag">Unanswered Questions</span>
          <h3>
            <a href="/development/del-norte-unanswered-questions/">
              The Del Norte questions residents are still waiting on
            </a>
          </h3>
          <p>
            Even after approval, key questions remain about park maintenance costs, future traffic impacts, field usability, affordability, and how Del Norte may affect nearby neighborhoods over time.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section topics-section">
    <div class="container">
      <div class="section-header clean-header">
        <div>
          <h2 class="section-title">Development Watch</h2>
          <p class="section-sub">
            Major projects that could shape housing, traffic, public land, parks, and city costs.
          </p>
        </div>
        <a class="view-all" href="/development/">View Development</a>
      </div>

      <div class="story-grid">
        <article class="story-card">
          <span class="story-tag">Del Norte</span>
          <h3>
            <a href="/development/del-norte-project-west-covina/">
              Del Norte project approved
            </a>
          </h3>
          <p>
            The City approved 232 homes on the former Del Norte School site after months of debate. The project includes park land, park fees, and homebuyer assistance funding, but concerns remain over traffic, recreation, and long-term city obligations.
          </p>
        </article>

        <article class="story-card">
          <span class="story-tag">City Yard</span>
          <h3>
            <a href="/development/west-covina-city-yard-brandywine/">
              City Yard / Brandywine redevelopment explained
            </a>
          </h3>
          <p>
            Public land, possible relocation issues, housing plans,
            and long-term city impacts.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header clean-header">
        <div>
          <h2 class="section-title">Residents Are Talking About</h2>
          <p class="section-sub">
            Daily-life issues affecting parking, pets, bills, neighborhoods, and services.
          </p>
        </div>
      </div>

      <div class="story-grid">
        <article class="story-card">
          <span class="story-tag">Street Sweeping</span>
          <h3>
            <a href="/neighborhood-impact/west-covina-street-sweeping-parking-concerns/">
              Why street sweeping has residents showing up to City Hall
            </a>
          </h3>
          <p>
            The city says street-sweeping warnings and citations are temporarily suspended during route reevaluation. Sweeping continues, and residents are awaiting final schedules and notice before enforcement restarts.
          </p>
        </article>

        <article class="story-card">
          <span class="story-tag">Community & Pets</span>
          <h3>
            <a href="/community-pets/west-covina-spay-neuter-microchip-requirements/">
              New spay, neuter, and microchip rules explained
            </a>
          </h3>
          <p>
            LA County announced field animal licensing checks beginning November 12 in West Covina ZIP codes 91791 and 91792. Residents can review licensing, microchip, spay/neuter requirements, and potential $40 field enforcement fees.
          </p>
        </article>

        <article class="story-card">
          <span class="story-tag">Trash Rates</span>
          <h3>
            <a href="/city-hall/athens-services-west-covina-trash-contract-rate-increases-2048/">
              Athens Services contract, rate increases, and 2048 lock-in
            </a>
          </h3>
          <p>
            How West Covina’s long-term trash agreement affects residents,
            businesses, fees, and city leverage.
          </p>
        </article>

        <article class="story-card">
          <span class="story-tag">City Manager</span>
          <h3>
            <a href="/city-hall/west-covina-city-manager-milan-mrakich/">
              Milan Mrakich appointed permanent City Manager
            </a>
          </h3>
          <p>
            The City Council appointed Milan Mrakich as West Covina's permanent City Manager. Supporters point to decades of public service experience, while others raised questions about qualifications, compensation, and the City's long-term direction.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section unanswered-section">
    <div class="container">
      <div class="section-header clean-header">
        <div>
          <h2 class="section-title">Unanswered Questions</h2>
          <p class="section-sub">
            StayJustIn will keep tracking these until residents get clearer answers.
          </p>
        </div>
      </div>

      <div class="story-grid">
        <article class="story-card">
          <span class="story-tag">Del Norte</span>
          <h3>
            <a href="/development/del-norte-unanswered-questions/">
              What questions remain after Del Norte approval?
            </a>
          </h3>
          <p>
            Even after approval, key questions remain about park maintenance costs, future traffic impacts, field usability, affordability, and how Del Norte may affect nearby neighborhoods over time.
          </p>
        </article>

        <article class="story-card">
          <span class="story-tag">Combined Impact</span>
          <h3>
            <a href="/development/del-norte-city-yard-combined-impact/">
              Has Del Norte been studied together with City Yard?
            </a>
          </h3>
          <p>
            Residents asked about cumulative impacts. The answer matters for traffic,
            services, and infrastructure.
          </p>
        </article>

        <article class="story-card">
          <span class="story-tag">Parks</span>
          <h3>
            <a href="/development/del-norte-park-fee/">
              Will the Del Norte park fee improve Del Norte Park?
            </a>
          </h3>
          <p>
            Residents want to know where the money will actually be spent.
          </p>
        </article>

        <article class="story-card">
          <span class="story-tag">Athens</span>
          <h3>
            <a href="/city-hall/athens-services-west-covina-trash-contract-rate-increases-2048/">
              What leverage does West Covina have before 2048?
            </a>
          </h3>
          <p>
             A series of contract amendments extended West Covina's exclusive Athens Services agreement through at least 2048. The deal affects trash rates, enforcement policies, and the City's ability to seek competing waste providers.

          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header clean-header">
        <div>
          <h2 class="section-title">Follow the Big Issues</h2>
          <p class="section-sub">
            Permanent coverage areas for ongoing West Covina stories.
          </p>
        </div>
      </div>

      <div class="topics-grid">
        <a href="/development/" class="topic-card">
          <span>🏗️</span>
          <strong>Development Watch</strong>
        </a>

        <a href="/city-hall/" class="topic-card">
          <span>🏛️</span>
          <strong>City Hall Watch</strong>
        </a>

        <a href="/neighborhood-impact/" class="topic-card">
          <span>🚗</span>
          <strong>Neighborhood Impact</strong>
        </a>

        <a href="/community-pets/" class="topic-card">
          <span>🐶</span>
          <strong>Community & Pets</strong>
        </a>

        <a href="/west-covina-news/" class="topic-card">
          <span>📰</span>
          <strong>West Covina News</strong>
        </a>

        <a href="/events/" class="topic-card">
          <span>📅</span>
          <strong>Events</strong>
        </a>
      </div>
    </div>
  </section>

<p class="article-principle">
    <span>“Speak up for those who cannot speak for themselves.”</span><br />
    <strong>— Proverbs 31:8</strong>
  </p>


  <section class="section bottom-links-section">
    <div class="container bottom-links-card">
      <h2>More From StayJustIn</h2>
      <p>
        Local reporting, public records, document breakdowns, meeting analysis,
        and ways to send tips.
      </p>

      <div class="bottom-link-list">
        <a href="/development/del-norte-project-west-covina/">Del Norte</a>
        <a href="/development/del-norte-park-fee/">Park Fee</a>
        <a href="/development/del-norte-field-debate/">Field Debate</a>
        <a href="/development/del-norte-city-yard-combined-impact/">Combined Impact</a>
        <a href="/development/del-norte-unanswered-questions/">Unanswered Questions</a>
        <a href="/development/west-covina-city-yard-brandywine/">City Yard</a>
        <a href="/city-hall/athens-services-west-covina-trash-contract-rate-increases-2048/">Athens Contract</a>
        <a href="/contact/">Send a Tip</a>
        <a href="https://stayjustin.substack.com" target="_blank" rel="noopener noreferrer">
          Subscribe on Substack
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .budget-front-feature { padding-top: 1.5rem; padding-bottom: 1rem; }
  .budget-front-card { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(245px, 1fr); gap: clamp(1.2rem, 3vw, 2.5rem); align-items: center; padding: clamp(1.3rem, 3vw, 2.2rem); background: #f8fafc; border: 1px solid #cbd5e1; border-left: 7px solid #0f766e; border-radius: 1rem; }
  .budget-front-date { display: inline-block; margin: 0 0 .8rem; padding: .5rem .7rem; font-size: .92rem; font-weight: 900; letter-spacing: .045em; color: #064e3b; background: #d1fae5; border: 1px solid #0f766e; border-radius: .4rem; }
  .budget-front-copy h2 { font-size: clamp(1.65rem, 3vw, 2.4rem); line-height: 1.18; margin: 0 0 1rem; }
  .budget-front-copy h2 a { color: #0f172a; text-decoration: none; }
  .budget-front-copy h2 a:hover { text-decoration: underline; }
  .budget-front-copy > p:not(.budget-front-date) { font-size: 1.1rem; line-height: 1.7; color: #334155; }
  .budget-front-link { display: inline-block; margin-top: .8rem; font-weight: 800; font-size: 1.05rem; color: #065f46; text-decoration: underline; text-underline-offset: 3px; }
  .budget-front-figures { display: grid; gap: .65rem; }
  .budget-front-figures > div { display: flex; justify-content: space-between; align-items: baseline; gap: .8rem; padding: .8rem 1rem; background: #fff; border: 1px solid #dbe4ea; border-radius: .5rem; }
  .budget-front-figures span { font-size: .9rem; color: #475569; }
  .budget-front-figures strong { font-size: 1.35rem; color: #0f172a; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .budget-front-figures small { color: #475569; line-height: 1.5; }
  @media (max-width: 750px) { .budget-front-card { grid-template-columns: 1fr; } }
</style>


<style>
  .budget-coverage-date { display: inline-block; padding: .4rem .65rem; background: #d1fae5; color: #064e3b; border: 1px solid #0f766e; border-radius: .4rem; font-weight: 900; font-size: .94rem; letter-spacing: .03em; }
  .budget-coverage-note { margin-top: 1.1rem; color: #475569; font-size: .94rem; line-height: 1.6; }
  .budget-coverage-note a { font-weight: 700; }
</style>
