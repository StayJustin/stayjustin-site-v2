---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  title="About StayJustin | West Covina News Explained Simply"
  description="Learn about StayJustin, a local West Covina news site focused on City Hall, new businesses, development, traffic, and events."
  canonical="https://www.stayjustin.com/about/"
>
  <section class="section">
    <div class="container intro-block">
      <h1 class="section-title">About StayJustin</h1>
      <p class="intro-copy">
        StayJustin is a local West Covina news and information site built to explain what is happening in the city in simple terms.
        The goal is to make City Hall decisions, new businesses, development updates, traffic changes, and local events easier to follow.
      </p>
      <p class="intro-copy">
        Instead of burying people in jargon, long agendas, or scattered posts, StayJustin focuses on clear explanations,
        useful context, and the local stories that actually affect everyday life in West Covina.
      </p>
    </div>
  </section>
</MainLayout>
