---
import MainLayout from "../../layouts/MainLayout.astro";

const title = "Accountability Tracker | StayJustIn";
const description = "Follow ongoing West Covina issues, unanswered questions, public decisions, and resident concerns being tracked by StayJustIn.";
---

<MainLayout
  title={title}
  description={description}
  canonical="https://www.stayjustin.com/accountability/"
>
  <section class="news-hero">
    <div class="container">
      <span class="eyebrow">StayJustIn Accountability</span>
      <h1>Follow the Issues That Need Answers</h1>
      <p>
        Ongoing West Covina issues, public questions, documents, timelines,
        and follow-up items in one place.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header clean-header">
        <div>
          <h2 class="section-title">Currently Tracking</h2>
          <p class="section-sub">
            These are living issue pages. StayJustIn submitted questions on July 7, 2026 and will update each tracker when the City responds or new public records become available.
          </p>
        </div>
      </div>

      <div class="story-grid">
        <article class="story-card">
          <span class="story-tag">Awaiting City Response</span>
          <h3>
            <a href="/accountability/street-sweeping/">
              Street Sweeping Enforcement
            </a>
          </h3>
          <p>
            Tracking corrected signs, final maps, alternate-side streets, warning periods, citation timing, and whether residents receive clear notice before enforcement begins.
          </p>
        </article>

        <article class="story-card">
          <span class="story-tag">Awaiting Cost Update</span>
          <h3>
            <a href="/accountability/fire-station-3/">
              Fire Station 3 Emergency Repairs
            </a>
          </h3>
          <p>
            Tracking emergency repair authority, total approved cost, amount spent to date, remaining work, temporary firefighter arrangements, and what condition ends the emergency action.
          </p>
        </article>

        <article class="story-card">
          <span class="story-tag">Awaiting Clarification</span>
          <h3>
            <a href="/accountability/budget-spending/">
              Budget & Spending Watch
            </a>
          </h3>
          <p>
            Tracking sewer fund reserves, public repair planning, budget amendments, contracts, grants, emergency spending, and major city funds residents should understand.
          </p>
        </article>
      </div>
    </div>
  </section>
</MainLayout>
