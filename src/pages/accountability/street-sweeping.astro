---
import RecordUpdate from "../../components/RecordUpdate.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import ArticleSummary from "../../components/ArticleSummary.astro";
import ArticleMetadata from "../../components/ArticleMetadata.astro";
import WhyThisMatters from "../../components/WhyThisMatters.astro";
import WhatWeKnow from "../../components/WhatWeKnow.astro";
import WhatWeDontKnow from "../../components/WhatWeDontKnow.astro";
import QuestionsResidentsShouldAsk from "../../components/QuestionsResidentsShouldAsk.astro";
import AccountabilityTracker from "../../components/AccountabilityTracker.astro";
import CommunityFeedback from "../../components/CommunityFeedback.astro";
import RelatedCoverage from "../../components/RelatedCoverage.astro";

const title = "Street Sweeping Enforcement Tracker | StayJustIn";
const description = "A living tracker for West Covina street sweeping enforcement, corrected signs, final maps, alternate-side streets, warning periods, citations, and City responses.";
---

<MainLayout
  title={title}
  description={description}
  canonical="https://www.stayjustin.com/accountability/street-sweeping/"
>
  <section class="article-page">
    <div class="container article-container">
      <p class="page-kicker">Accountability Hub</p>

      <h1>Street Sweeping Enforcement Tracker</h1>

      <RecordUpdate title="Current notice: warnings and citations suspended" paragraphs={["The City’s official webpage, checked October 23, says street-sweeping warnings and citations are suspended during program reevaluation. Sweepers continue operating, and actual times may differ from existing signs. The City says it will notify residents when the updated schedule is finalized.", "The October CIP presentation marks signage Phase I complete in November 2025 and lists Phase II as upcoming. That is a phased project status, not a finding that all signs and routes are final. The historical questions below remain part of the tracker."]} href="/city-hall/street-sweeping-phase-one-phase-two-october-2026/" />

      <ArticleMetadata
        category="Accountability Tracker"
        updated="October 23, 2026 | Original questions submitted July 7"
      />

      <ArticleSummary text="StayJustIn is tracking West Covina street sweeping enforcement, corrected signs, final maps, alternate-side streets, warning periods, citation timing, and whether residents receive clear notice before tickets begin." />

      <WhyThisMatters
        items={[
          "Street sweeping affects residents across the city, especially neighborhoods with limited parking.",
          "Missing, outdated, or incorrect signs can turn a city service into an unfair citation problem.",
          "Residents need clear maps, corrected signs, and a warning period before paid enforcement begins."
        ]}
      />

      <WhatWeKnow
        items={[
          "Residents raised concerns at the July 7, 2026 City Council meeting about missing signs, incorrect-day postings, outdated signs, alternate-side sweeping requests, school-zone conflicts, and parking hardship.",
          "StayJustIn submitted written questions to the City on July 7, 2026 regarding enforcement timing, corrected maps, signage updates, alternate-side streets, warning cycles, public concern logs, and citation amounts.",
          "As checked October 23, the City webpage explicitly suspends both street-sweeping warnings and citations during reevaluation and transition.",
          "The October CIP distinguishes completed Phase I signage from upcoming Phase II. A final enforcement restart date is not provided by the current City notice."
        ]}
      />

      <WhatWeDontKnow
        items={[
          "The exact date street sweeping citations will begin has not yet been confirmed to StayJustIn.",
          "The final corrected map and list of streets changed to alternate-side sweeping have not yet been provided to StayJustIn.",
          "It is not yet clear whether residents will receive one full warning cycle after corrected signs and maps are finalized.",
          "The full count of signs that were missing, incorrect, outdated, replaced, moved, or added still needs a public-facing summary.",
          "It is not yet clear whether the City will release the concern log showing what was reviewed and what changed."
        ]}
      />

      <QuestionsResidentsShouldAsk
        questions={[
          "What exact date will street sweeping citations begin?",
          "Will the final corrected map be posted before tickets start?",
          "Which streets are being changed to alternate-side sweeping?",
          "How many signs were missing, wrong, outdated, replaced, moved, or added?",
          "Will residents receive at least one full warning cycle after corrected signs are installed?",
          "Will the City make the resident concern log available to the public?",
          "How much will each citation be?"
        ]}
      />

      <AccountabilityTracker
        title="Street Sweeping Follow-Up Tracker"
        items={[
          {
            question: "Has the City clearly announced when citations will begin?",
            status: "pending",
            note: "Question submitted July 7. October 23 source check: the City notice describes a suspension but does not resolve this specific question."
          },
          {
            question: "Has the City published the final corrected street sweeping map?",
            status: "pending",
            note: "Question submitted July 7. October 23 source check: the City notice describes a suspension but does not resolve this specific question."
          },
          {
            question: "Has the City released the list of streets changed to alternate-side sweeping?",
            status: "pending",
            note: "Question submitted July 7. October 23 source check: the City notice describes a suspension but does not resolve this specific question."
          },
          {
            question: "Will residents get one full warning cycle after corrected signs and maps are finalized?",
            status: "pending",
            note: "Question submitted July 7. October 23 source check: the City notice describes a suspension but does not resolve this specific question."
          },
          {
            question: "Will the City release the concern log showing what was reviewed and changed?",
            status: "pending",
            note: "Question submitted July 7. October 23 source check: the City notice describes a suspension but does not resolve this specific question."
          }
        ]}
      />

      <CommunityFeedback />

      <RelatedCoverage
        title="Continue Following This Issue"
        items={[
          {
            title: "Why Street Sweeping Has Residents Showing Up to City Hall",
            href: "/neighborhood-impact/west-covina-street-sweeping-parking-concerns/",
            description: "The original developing story explaining resident concerns about parking, signs, warnings, and possible tickets."
          },
          {
            title: "Budget & Spending Watch",
            href: "/accountability/budget-spending/",
            description: "Follow related spending questions involving signage, enforcement, equipment, and city funds."
          },
          {
            title: "City Hall Watch",
            href: "/city-hall/",
            description: "Track public meetings, policy decisions, spending, contracts, and city responses."
          }
        ]}
      />
    </div>
  </section>
</MainLayout>
