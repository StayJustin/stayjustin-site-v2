---
import MainLayout from "../../layouts/MainLayout.astro";
import ArticleSummary from "../../components/ArticleSummary.astro";
import ArticleMetadata from "../../components/ArticleMetadata.astro";
import WhyThisMatters from "../../components/WhyThisMatters.astro";
import WhatWeKnow from "../../components/WhatWeKnow.astro";
import WhatWeDontKnow from "../../components/WhatWeDontKnow.astro";
import QuestionsResidentsShouldAsk from "../../components/QuestionsResidentsShouldAsk.astro";
import AccountabilityTracker from "../../components/AccountabilityTracker.astro";
import CommunityFeedback from "../../components/CommunityFeedback.astro";
import RelatedCoverage from "../../components/RelatedCoverage.astro";

const title = "Why Street Sweeping Has Residents Showing Up to City Hall | StayJustIn";
const description = "A developing breakdown of West Covina street sweeping concerns, including parking signs, enforcement, warnings, tickets, and resident communication.";
---

<MainLayout
  title={title}
  description={description}
  canonical="https://www.stayjustin.com/neighborhood-impact/west-covina-street-sweeping-parking-concerns/"
>
  <section class="article-page">
    <div class="container article-container">
      <p class="page-kicker">Neighborhood Impact</p>

      <h1>Why Street Sweeping Has Residents Showing Up to City Hall</h1>

      <ArticleMetadata
        category="Neighborhood Impact"
        updated="Developing story"
      />

      <ArticleSummary text="Street sweeping has become one of West Covina's most visible neighborhood issues as residents raise concerns about parking, signs, warnings, enforcement, and possible tickets." />

      <WhyThisMatters
        items={[
          "Street sweeping affects residents citywide, not just one neighborhood.",
          "The issue connects clean streets with parking access, signage, notice, and enforcement.",
          "Residents want clear information before penalties begin."
        ]}
      />

      <WhatWeKnow
        items={[
          "Residents have raised concerns about street sweeping, parking signs, and possible tickets.",
          "The issue is about communication, notice, signage, and enforcement.",
          "Residents are not against cleaner streets; they want clear information before penalties begin."
        ]}
      />

      <WhatWeDontKnow
        items={[
          "The exact enforcement timeline still needs to be clearly confirmed for residents.",
          "It is not yet clear how warnings, grace periods, or first-time violations will be handled.",
          "Residents still need a clear way to confirm which streets, days, and parking restrictions apply to them."
        ]}
      />

      <QuestionsResidentsShouldAsk
        questions={[
          "When does enforcement begin?",
          "Will warnings be issued before tickets?",
          "Which streets are affected?",
          "Where should residents park if space is limited?",
          "How will the City communicate changes before enforcement starts?"
        ]}
      />

      <AccountabilityTracker
        title="Street Sweeping Accountability Tracker"
        items={[
          {
            question: "Has the City clearly announced when enforcement begins?",
            status: "pending",
            note: "Residents are still asking for clear timing and notice."
          },
          {
            question: "Has the City explained whether warnings will come before tickets?",
            status: "pending",
            note: "This remains one of the most common resident questions."
          },
          {
            question: "Has the City provided a simple map or street-by-street schedule?",
            status: "pending",
            note: "A clear public schedule would help residents avoid confusion."
          }
        ]}
      />

      <CommunityFeedback />

      <RelatedCoverage
        items={[
          {
            title: "Neighborhood Impact",
            href: "/neighborhood-impact/",
            description: "Follow local issues affecting parking, streets, neighborhoods, and daily life."
          },
          {
            title: "City Hall Watch",
            href: "/city-hall/",
            description: "Track City Council decisions, public meetings, spending, and policy changes."
          }
        ]}
      />
    </div>
  </section>
</MainLayout>
