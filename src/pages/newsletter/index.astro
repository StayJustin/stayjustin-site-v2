---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  title="StayJustin Newsletter Archive"
  description="Read the StayJustin newsletter archive for West Covina news, City Hall coverage, and local updates."
  canonical="https://www.stayjustin.com/newsletter/"
>
  <section class="section">
    <div class="container intro-block">
      <h1 class="section-title">Newsletter Archive</h1>
      <p class="intro-copy">
        This page is the archive for StayJustin newsletter coverage and major local updates.
      </p>
      <p class="intro-copy">
        For now, you can read the latest newsletter posts here:
        <br />
        <a href="https://stayjustin.substack.com" target="_blank" rel="noopener noreferrer">
          Visit the StayJustin newsletter
        </a>
      </p>
      <p class="intro-copy">
        Over time, this archive can also link to major stories, weekly recaps, and featured West Covina coverage published on the site.
      </p>
    </div>
  </section>
</MainLayout>
