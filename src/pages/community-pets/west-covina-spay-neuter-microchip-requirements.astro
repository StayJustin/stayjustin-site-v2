---
import MainLayout from "../../layouts/MainLayout.astro";
import ArticleStyles from "../../components/ArticleStyles.astro";

const title = "New Spay, Neuter, and Microchip Rules Explained | StayJustIn";
const description = "A developing breakdown of West Covina's new pet-related requirements involving spay, neuter, microchipping, shelter overcrowding, compliance, and resident resources.";
---

<MainLayout
  title={title}
  description={description}
  canonical="https://www.stayjustin.com/community-pets/west-covina-spay-neuter-microchip-requirements/"
>
  <ArticleStyles />

  <section class="article-page">
    <div class="container article-container">
      <p class="page-kicker">Community &amp; Pets</p>

      <h1>New Spay, Neuter, and Microchip Rules Explained</h1>

      <p class="article-dek">
        West Covina pet owners are asking what the City's new spay, neuter, and microchip rules mean, who is affected, and what resources will be available.
      </p>

      <p><strong>Status:</strong> Developing Story</p>

      <div class="info-box">
        <h2>What We Know So Far</h2>

        <ul class="check-list">
          <li>West Covina approved new pet-related requirements.</li>
          <li>The rules involve spay, neuter, and microchipping.</li>
          <li>The goals include reducing shelter overcrowding and improving pet recovery.</li>
          <li>Pet owners are asking about costs, compliance, and resources.</li>
        </ul>
      </div>

      <div class="info-box">
        <h2>Questions Residents Are Asking</h2>

        <ul class="question-list">
          <li>Who is affected?</li>
          <li>What exemptions apply?</li>
          <li>What low-cost resources are available?</li>
          <li>How will the City educate residents?</li>
        </ul>
      </div>

      <p>
        StayJustIn is reviewing public documents, council discussions, and future city actions to update this story.
      </p>

      <hr />

      <p><em>Full investigation coming soon.</em></p>
    </div>
  </section>
</MainLayout>
