---
import MainLayout from "../../../layouts/MainLayout.astro";
import streetSweeping from "../../../data/issues/street-sweeping.json";
import delNorte from "../../../data/issues/del-norte.json";
import athens from "../../../data/issues/athens.json";

export function getStaticPaths() {
  const issueList = [streetSweeping, delNorte, athens];

  return issueList.map((issue) => ({
    params: { slug: issue.slug },
    props: { issue }
  }));
}

const { issue } = Astro.props;
const title = `${issue.title} Workspace | Just-In Desk`;
const description = issue.summary;
---

<MainLayout
  title={title}
  description={description}
  canonical={`https://www.stayjustin.com/desk/issues/${issue.slug}/`}
>
  <section class="article-page">
    <div class="container article-container">
      <p class="page-kicker">Just-In Desk Issue Workspace</p>
      <h1>{issue.title}</h1>

      <p class="article-dek">{issue.summary}</p>

      <div class="workspace-meta">
        <span>Status: {issue.status}</span>
        <span>Category: {issue.category}</span>
        <span>Priority: {issue.priority}</span>
        <span>Last Updated: {issue.lastUpdated}</span>
      </div>

      <section class="workspace-section">
        <h2>Open Questions</h2>
        <ul>
          {issue.openQuestions.map((question) => <li>{question}</li>)}
        </ul>
      </section>

      <section class="workspace-section">
        <h2>Timeline</h2>
        {issue.timeline.length > 0 ? (
          <div class="timeline-list">
            {issue.timeline.map((event) => (
              <article class="timeline-item">
                <span>{event.date}</span>
                <h3>{event.label}</h3>
                {event.note && <p>{event.note}</p>}
              </article>
            ))}
          </div>
        ) : (
          <p>No timeline events added yet.</p>
        )}
      </section>

      <section class="workspace-section">
        <h2>Evidence Binder</h2>
        {issue.evidence.length > 0 ? (
          <div class="evidence-list">
            {issue.evidence.map((item) => (
              <article class="evidence-item">
                <span>{item.type}</span>
                <h3>{item.title}</h3>
                <p><strong>Source:</strong> {item.source}</p>
                <p><strong>Status:</strong> {item.status}</p>
                {item.tags?.length > 0 && (
                  <p><strong>Tags:</strong> {item.tags.join(", ")}</p>
                )}
              </article>
            ))}
          </div>
        ) : (
          <p>No evidence items added yet.</p>
        )}
      </section>

      <section class="workspace-section">
        <h2>Tasks</h2>
        <ul>
          {issue.tasks.map((task) => <li>{task}</li>)}
        </ul>
      </section>

      <section class="workspace-section publish-actions">
        <h2>Publish From This Issue</h2>
        <p>
          Use this workspace as the source for public updates. Only move information to the public site when it helps residents understand the issue now.
        </p>
        <div class="action-links">
          <a href={issue.hubUrl}>Open Public Hub</a>
          <a href="/desk/intake/">Process New Packet</a>
          <a href="/desk/">Back to Desk</a>
        </div>
      </section>
    </div>
  </section>
</MainLayout>

<style>
  .workspace-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 1.5rem 0;
    color: #4b5563;
    font-weight: 700;
  }

  .workspace-section {
    margin: 2rem 0;
    padding: 1.5rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    background: #f8fafc;
  }

  .workspace-section h2 {
    margin-top: 0;
  }

  .workspace-section li {
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  .timeline-list,
  .evidence-list {
    display: grid;
    gap: 1rem;
  }

  .timeline-item,
  .evidence-item {
    padding: 1rem;
    border-left: 4px solid #111827;
    background: #ffffff;
    border-radius: 0.5rem;
  }

  .timeline-item span,
  .evidence-item span {
    color: #4b5563;
    font-size: 0.85rem;
    font-weight: 800;
  }

  .timeline-item h3,
  .evidence-item h3 {
    margin: 0.35rem 0;
  }

  .action-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .action-links a {
    font-weight: 800;
  }
</style>
