---
import IssueStatusBadge from "./IssueStatusBadge.astro";

type IssueStatus = "monitoring" | "developing" | "urgent" | "resolved";

interface Props {
  title: string;
  emoji?: string;
  status: IssueStatus;
  statusLabel: string;
  summary: string;
  href: string;
  lastUpdated?: string;
  featured?: boolean;
}

const {
  title,
  emoji = "📌",
  status,
  statusLabel,
  summary,
  href,
  lastUpdated,
  featured = false
} = Astro.props;
---

<article class={`issue-card ${featured ? "issue-card-featured" : ""}`}>
  <div class="issue-card-top">
    <span class="issue-emoji" aria-hidden="true">{emoji}</span>
    <IssueStatusBadge status={status} label={statusLabel} />
  </div>

  <h3>
    <a href={href}>{title}</a>
  </h3>

  <p>{summary}</p>

  {lastUpdated && (
    <p class="issue-updated">Last updated: {lastUpdated}</p>
  )}

  <a class="issue-link" href={href}>Follow this issue →</a>
</article>

<style>
  .issue-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    height: 100%;
    padding: 1.25rem;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 0.85rem;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05);
  }

  .issue-card-featured {
    border-left: 5px solid #111827;
    background: #f8fafc;
  }

  .issue-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .issue-emoji {
    font-size: 1.65rem;
  }

  .issue-card h3 {
    margin: 0;
    font-size: 1.3rem;
    line-height: 1.25;
  }

  .issue-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .issue-card h3 a:hover {
    text-decoration: underline;
  }

  .issue-card p {
    margin: 0;
    color: #374151;
    line-height: 1.6;
  }

  .issue-updated {
    font-size: 0.88rem;
    font-weight: 700;
    color: #6b7280 !important;
  }

  .issue-link {
    margin-top: auto;
    font-weight: 800;
    color: #111827;
    text-decoration: none;
  }

  .issue-link:hover {
    text-decoration: underline;
  }
</style>
