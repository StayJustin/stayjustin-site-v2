---
interface Props {
  category?: string;
  published?: string;
  updated?: string;
  author?: string;
}

const {
  category = "StayJustIn Report",
  published,
  updated,
  author = "StayJustIn"
} = Astro.props;
---

<div class="article-metadata" aria-label="Article information">
  <span>{category}</span>
  {published && <span>Published: {published}</span>}
  {updated && <span class="updated-highlight"><strong>UPDATED: {updated}</strong></span>}
  {author && <span>By {author}</span>}
</div>

<style>
  .article-metadata {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 1rem 0 1.5rem;
    color: #4b5563;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .article-metadata .updated-highlight {
    padding: 0.45rem 0.75rem;
    background: #e7f4f0;
    border: 2px solid #0f766e;
    border-radius: 0.45rem;
    color: #064e3b;
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: 0.02em;
  }
  .article-metadata span {
    display: inline-flex;
    align-items: center;
  }
</style>
