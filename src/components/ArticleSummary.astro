---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<section class="article-summary">
  <p>{text}</p>
</section>

<style>
  .article-summary {
    font-size: 1.15rem;
    line-height: 1.7;
    font-weight: 500;
    background: #f8fafc;
    border-left: 4px solid #111827;
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
    border-radius: 0.5rem;
  }

  .article-summary p {
    margin: 0;
  }
</style>
