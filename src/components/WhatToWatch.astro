---
import { watchItems } from "../data/watchItems";
---

<section class="what-to-watch-section" aria-labelledby="what-to-watch-heading">
  <div class="container">
    <div class="watch-shell" data-watch-ticker>
      <div class="watch-header">
        <div>
          <p class="watch-kicker">West Covina Pulse</p>
          <h2 id="what-to-watch-heading">What to Watch in West Covina</h2>
          <p>
            A rotating look at the updates, reminders, and unanswered questions residents should keep on their radar.
          </p>
        </div>
        <a class="watch-all-link" href="/accountability/">View trackers →</a>
      </div>

      <div class="watch-card-frame">
        {watchItems.map((item, index) => (
          <article
            class={`watch-card ${index === 0 ? "is-active" : ""} priority-${item.priority}`}
            data-watch-card
            aria-hidden={index === 0 ? "false" : "true"}
          >
            <div class="watch-card-top">
              <span class="watch-lane">{item.lane}</span>
              <span class="watch-type">{item.type}</span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
            <a href={item.href}>Follow this update →</a>
          </article>
        ))}
      </div>

      <div class="watch-controls" aria-label="What to Watch controls">
        {watchItems.map((item, index) => (
          <button
            type="button"
            class={index === 0 ? "is-active" : ""}
            data-watch-dot
            aria-label={`Show ${item.title}`}
          >
            <span>{index + 1}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const ticker = document.querySelector("[data-watch-ticker]");

  if (ticker) {
    const cards = Array.from(ticker.querySelectorAll("[data-watch-card]"));
    const dots = Array.from(ticker.querySelectorAll("[data-watch-dot]"));
    let activeIndex = 0;
    let timer;

    const showCard = (nextIndex) => {
      activeIndex = nextIndex;

      cards.forEach((card, index) => {
        const isActive = index === activeIndex;
        card.classList.toggle("is-active", isActive);
        card.setAttribute("aria-hidden", isActive ? "false" : "true");
      });

      dots.forEach((dot, index) => {
        dot.classList.toggle("is-active", index === activeIndex);
      });
    };

    const startTimer = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => {
        showCard((activeIndex + 1) % cards.length);
      }, 7000);
    };

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        showCard(index);
        startTimer();
      });
    });

    if (cards.length > 1) {
      startTimer();
    }
  }
</script>

<style>
  .what-to-watch-section {
    padding: 2rem 0 0;
  }

  .watch-shell {
    position: relative;
    overflow: hidden;
    border: 1px solid #d8dee8;
    border-radius: 1.2rem;
    background:
      radial-gradient(circle at top right, rgba(217, 164, 65, 0.22), transparent 32%),
      linear-gradient(135deg, #10243e 0%, #142f52 52%, #f4ebd0 52%, #f8fafc 100%);
    box-shadow: 0 16px 35px rgba(15, 23, 42, 0.12);
  }

  .watch-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: start;
    padding: 1.5rem 1.5rem 0.75rem;
    color: #ffffff;
  }

  .watch-kicker {
    margin: 0 0 0.35rem;
    color: #d9a441;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .watch-header h2 {
    margin: 0;
    font-size: clamp(1.55rem, 3vw, 2.2rem);
    line-height: 1.1;
  }

  .watch-header p {
    max-width: 46rem;
    margin: 0.65rem 0 0;
    color: #e5edf7;
    line-height: 1.6;
  }

  .watch-all-link {
    align-self: center;
    white-space: nowrap;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    padding: 0.55rem 0.9rem;
    color: #ffffff;
    font-weight: 800;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.08);
  }

  .watch-all-link:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .watch-card-frame {
    position: relative;
    min-height: 15rem;
    margin: 0.75rem;
  }

  .watch-card {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.25rem;
    border-radius: 0.95rem;
    background: rgba(255, 255, 255, 0.96);
    border-left: 6px solid #d9a441;
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition: opacity 220ms ease, transform 220ms ease;
  }

  .watch-card.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .watch-card.priority-high {
    border-left-color: #d97706;
  }

  .watch-card.priority-medium {
    border-left-color: #2563eb;
  }

  .watch-card.priority-low {
    border-left-color: #16a34a;
  }

  .watch-card-top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .watch-lane,
  .watch-type {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.25rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .watch-lane {
    background: #10243e;
    color: #ffffff;
  }

  .watch-type {
    background: #f4ebd0;
    color: #10243e;
  }

  .watch-card h3 {
    margin: 0;
    color: #10243e;
    font-size: clamp(1.35rem, 3vw, 2.2rem);
    line-height: 1.12;
  }

  .watch-card p {
    max-width: 54rem;
    margin: 0;
    color: #334155;
    line-height: 1.65;
  }

  .watch-card a {
    margin-top: auto;
    color: #10243e;
    font-weight: 900;
    text-decoration: none;
  }

  .watch-card a:hover {
    text-decoration: underline;
  }

  .watch-controls {
    display: flex;
    gap: 0.4rem;
    padding: 0 1.5rem 1.25rem;
  }

  .watch-controls button {
    border: 0;
    border-radius: 999px;
    width: 2rem;
    height: 0.5rem;
    padding: 0;
    background: rgba(255, 255, 255, 0.45);
    cursor: pointer;
  }

  .watch-controls button.is-active {
    width: 3rem;
    background: #d9a441;
  }

  .watch-controls span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (max-width: 720px) {
    .watch-header {
      grid-template-columns: 1fr;
    }

    .watch-all-link {
      justify-self: start;
    }

    .watch-card-frame {
      min-height: 18rem;
    }
  }
</style>
