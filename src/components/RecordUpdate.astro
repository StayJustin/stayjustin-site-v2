---
interface Props { title: string; paragraphs: string[]; href: string; linkText?: string; }
const { title, paragraphs, href, linkText = "Read the source-backed update →" } = Astro.props;
---
<aside class="record-update" aria-label="Latest reporting update">
  <p class="update-date">Updated October 23, 2026</p>
  <h2>{title}</h2>
  {paragraphs.map((text) => <p>{text}</p>)}
  <a href={href}>{linkText}</a>
</aside>
<style>
  .record-update { margin: 1.5rem 0 2rem; padding: 24px; border: 1px solid #e6d8b6; border-left: 5px solid #d9a441; border-radius: 12px; background: #fffcf4; color: #10243e; }
  .record-update .update-date { font-size: .78rem; text-transform: uppercase; font-weight: 800; letter-spacing: .06em; margin: 0 0 8px; }
  .record-update h2 { margin: 0 0 12px; font-size: 1.4rem; line-height: 1.3; }
  .record-update p { line-height: 1.7; margin: 0 0 12px; }
  .record-update a { font-weight: 800; text-decoration: underline; }
</style>
