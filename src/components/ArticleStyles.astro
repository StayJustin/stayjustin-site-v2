---
interface Props {
  title?: string;
  text: string;
}

const {
  title = "Summary",
  text
} = Astro.props;
---

<section class="article-summary">
  <h2>{title}</h2>

  <p>{text}</p>
</section>

<style>
  .article-summary {
    margin: 2rem 0;
    padding: 1.5rem;
    background: #f8fafc;
    border-left: 4px solid #1d4ed8;
    border-radius: 0.5rem;
  }

  .article-summary h2 {
    margin: 0 0 0.75rem;
    font-size: 1.35rem;
  }

  .article-summary p {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.8;
  }
</style>